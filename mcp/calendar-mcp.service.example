[Unit]
Description=Calendar personal MCP server
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/calendar
EnvironmentFile=/etc/calendar-mcp.env
ExecStart=/usr/bin/node /var/www/calendar/mcp/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
